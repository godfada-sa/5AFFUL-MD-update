# Identity and access
OWNER_NUMBER=233XXXXXXXXX
SUDO=233XXXXXXXXX
OWNER_NAME=Safful
BOT_NAME=Safful-Md

# Bot behaviour
PREFIX=.
MODE=private
PORT=8001
TZ=Atlantic/Reykjavik
SAFFUL_SELF_HOSTED=true

# Fresh-login method for non-interactive hosts such as systemd.
